#!/usr/bin/python3
"""Mounts the RAM-only tailnet folder for a root caller, safe against a box
process that swaps or renames path components while it runs.

Usage: sand-tailnet-mount <path> <options> <require_empty 0|1>

The folder is opened through a directory fd that never follows a symlink, and
the tmpfs goes onto that fd: `mount --no-canonicalize` hands the kernel
/proc/self/fd/N as is, so no path string is resolved again between the checks
and mount(2). libmount's fd-based API (util-linux 2.41+) moves the new mount
onto that path without following the fd link and fails with ENOENT, so the
call is pinned to classic mount(2), which follows it. The mount must then be visible at <path> and the fd's directory
must still be <path>; a mount that landed anywhere else is taken off again.

Exit codes: 0 mounted at <path>; 1 not mounted; 4 the folder holds files and
<require_empty> is 1; 5 the mount landed elsewhere and was taken off; 6 the
mount landed elsewhere and is still there.
"""

import ctypes
import os
import re
import subprocess
import sys

MOUNTINFO = os.environ.get("SAND_TAILNET_MOUNTINFO", "/proc/self/mountinfo")
UMOUNT_NOFOLLOW = 8
MNT_DETACH = 2
OPEN_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


def parts_of(path):
    parts = [part for part in path.split("/") if part]
    if (
        not path.startswith("/")
        or not parts
        or any(part in (".", "..") for part in parts)
    ):
        raise ValueError(path)
    return parts


def open_nofollow(parts, create_last):
    fd = os.open("/", OPEN_FLAGS)
    try:
        for index, part in enumerate(parts):
            try:
                child = os.open(part, OPEN_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                if not create_last or index != len(parts) - 1:
                    raise
                os.mkdir(part, 0o700, dir_fd=fd)
                child = os.open(part, OPEN_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = child
    except BaseException:
        os.close(fd)
        raise
    return fd


def unescape(field):
    return re.sub(r"\\([0-7]{3})", lambda match: chr(int(match.group(1), 8)), field)


def mount_type_at(path):
    found = None
    try:
        with open(MOUNTINFO, encoding="utf-8", errors="surrogateescape") as lines:
            for line in lines:
                fields = line.split()
                if len(fields) < 7 or "-" not in fields[6:]:
                    continue
                separator = fields.index("-", 6)
                if separator + 1 < len(fields) and unescape(fields[4]) == path:
                    found = fields[separator + 1]
    except OSError:
        return None
    return found


def where_fd_is(fd):
    try:
        return os.readlink(f"/proc/self/fd/{fd}")
    except OSError:
        return None


def take_off(target):
    stub = os.environ.get("SAND_TAILNET_UMOUNT_STUB")
    if stub and os.geteuid() != 0:
        done = subprocess.run(
            [stub, target],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return done.returncode == 0
    libc = ctypes.CDLL(None, use_errno=True)
    return libc.umount2(os.fsencode(target), MNT_DETACH | UMOUNT_NOFOLLOW) == 0


def main(argv):
    if len(argv) != 4 or argv[3] not in ("0", "1"):
        return 1
    path, options, require_empty = argv[1], argv[2], argv[3] == "1"
    try:
        fd = open_nofollow(parts_of(path), create_last=True)
    except (OSError, ValueError):
        return 1
    try:
        if require_empty and os.listdir(fd):
            return 4
        subprocess.run(
            [
                "mount",
                "--no-canonicalize",
                "-t",
                "tmpfs",
                "-o",
                options,
                "sand-tailnet",
                f"/proc/self/fd/{fd}",
            ],
            pass_fds=(fd,),
            env={**os.environ, "LIBMOUNT_FORCE_MOUNT2": "always"},
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        landed = where_fd_is(fd)
        if landed == path and mount_type_at(path) == "tmpfs":
            return 0
        if landed is None or landed == path or mount_type_at(landed) != "tmpfs":
            return 1
        if take_off(landed) and mount_type_at(landed) != "tmpfs":
            return 5
        return 6
    except OSError:
        return 1
    finally:
        os.close(fd)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
