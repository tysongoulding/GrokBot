#!/bin/sh
set -eu

INSTALL_ROOT=$(readlink -f /usr/local/lib/sand-playwright-mcp/current)
RUNTIME="$INSTALL_ROOT/node_modules/@anysphere/sand-playwright-runtime"
PLAYWRIGHT_CORE="$INSTALL_ROOT/node_modules/playwright-core"
WORKER=/opt/sand-playwright-runtime/dist/worker.js
test -r "$RUNTIME/dist/worker.js"
test -r "$PLAYWRIGHT_CORE/package.json"
UID_VALUE=$(id -u sand-pw-unsafe)
GID_VALUE=$(id -g sand-pw-unsafe)
BRIDGE_DIR=$(mktemp -d /run/sand-playwright-bridge.XXXXXX)
IPC_SOCKET="$BRIDGE_DIR/ipc.sock"
PROXY_SOCKET="$BRIDGE_DIR/proxy.sock"
chown root:sand-pw-unsafe "$BRIDGE_DIR"
chmod 710 "$BRIDGE_DIR"

cleanup() {
	kill "$IPC_BRIDGE_PID" "$PROXY_BRIDGE_PID" 2>/dev/null || true
	wait "$IPC_BRIDGE_PID" "$PROXY_BRIDGE_PID" 2>/dev/null || true
	rm -rf "$BRIDGE_DIR"
}

wait_for_socket() {
	socket=$1
	pid=$2
	attempts=0
	while [ ! -S "$socket" ]; do
		kill -0 "$pid"
		attempts=$((attempts + 1))
		[ "$attempts" -lt 500 ]
		sleep 0.01
	done
}

trap cleanup EXIT
/usr/bin/socat UNIX-LISTEN:"$IPC_SOCKET",mode=0660,user=root,group=sand-pw-unsafe FD:3 &
IPC_BRIDGE_PID=$!
/usr/bin/socat UNIX-LISTEN:"$PROXY_SOCKET",mode=0600,user=root,group=root FD:4 &
PROXY_BRIDGE_PID=$!
wait_for_socket "$IPC_SOCKET" "$IPC_BRIDGE_PID"
wait_for_socket "$PROXY_SOCKET" "$PROXY_BRIDGE_PID"

/usr/bin/prlimit \
	--nofile=256 \
	--nproc=32 \
	--fsize=1048576 \
	--core=0 \
	-- \
	/usr/bin/unshare --net -- \
	/usr/bin/bwrap \
	--unshare-pid \
	--unshare-ipc \
	--unshare-uts \
	--die-with-parent \
	--new-session \
	--ro-bind /usr /usr \
	--ro-bind /bin /bin \
	--ro-bind /lib /lib \
	--ro-bind /lib64 /lib64 \
	--ro-bind /exec-daemon /exec-daemon \
	--dir /opt \
	--chmod 0755 /opt \
	--ro-bind "$RUNTIME" /opt/sand-playwright-runtime \
	--ro-bind "$PLAYWRIGHT_CORE" /opt/sand-playwright-runtime/node_modules/playwright-core \
	--proc /proc \
	--dev /dev \
	--tmpfs /tmp \
	--tmpfs /run \
	--tmpfs /home \
	--tmpfs /root \
	--tmpfs /workspace \
	--bind "$BRIDGE_DIR" /run/sand-playwright-bridge \
	--clearenv \
	--setenv HOME /home/sand-pw-unsafe \
	--setenv TMPDIR /tmp \
	--setenv LANG C.UTF-8 \
	--setenv NODE_ENV production \
	--setenv SAND_PLAYWRIGHT_WORKER_CHANNEL /run/sand-playwright-bridge/ipc.sock \
	-- \
	/bin/sh -ceu '
		test -r "$3" || {
			printf "isolated worker is not readable: %s\n" "$3" >&2
			ls -la /opt/sand-playwright-runtime /opt/sand-playwright-runtime/dist >&2
			exit 1
		}
		ip link set lo up
		socat TCP-LISTEN:19090,bind=127.0.0.1,reuseaddr UNIX-CONNECT:/run/sand-playwright-bridge/proxy.sock &
		exec setpriv \
			--reuid="$1" \
			--regid="$2" \
			--clear-groups \
			--inh-caps=-all \
			--ambient-caps=-all \
			--bounding-set=-all \
			--no-new-privs \
			/exec-daemon/node \
			--max-old-space-size=384 \
			"$3"
	' sand-playwright-isolate "$UID_VALUE" "$GID_VALUE" "$WORKER"
