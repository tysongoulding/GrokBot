{
  "name": "@anysphere/sand-playwright-runtime",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sand-playwright-mcp": "dist/main.js"
  },
  "exports": {
    ".": {
      "anysphere-source": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "scripts/**/*",
    "package.json"
  ],
  "bundledDependencies": [
    "ws",
    "zod"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build-types": "tsc -p tsconfig.build.json",
    "check": "oxlint src test && tsc --noEmit",
    "fix": "oxlint --fix src test",
    "format": "oxfmt --write src test package.json tsconfig.json tsconfig.build.json",
    "format:check": "oxfmt --check src test package.json tsconfig.json tsconfig.build.json",
    "test": "vitest run",
    "test:integration": "node test/run-integration.mjs",
    "bench:click": "node test/bench-click.mjs",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "playwright-core": "1.63.0-alpha-2026-08-31"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "@typescript/native": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  }
}
